load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gateway-simulator_lib",
    srcs = [
        "main.go",
        "metrics.go",
        "runtime.go",
    ],
    importpath = "github.com/Hirom0112/Base-GridOS/services/gateway-simulator/cmd/gateway-simulator",
    visibility = ["//visibility:private"],
    deps = [
        "//contracts/gen/go/gridos/v1:gridos",
        "//contracts/gen/go/gridos/v1/gridosv1connect",
        "//services/gateway-simulator/cmd/scenario",
        "//services/gateway-simulator/internal/battery",
        "//services/gateway-simulator/internal/failures",
        "//services/gateway-simulator/internal/gateway",
        "//services/gateway-simulator/internal/observability",
        "//services/gateway-simulator/internal/protocol",
        "//services/gateway-simulator/internal/telemetry",
        "@com_connectrpc_connect//:connect",
        "@io_opentelemetry_go_otel//:otel",
    ],
)

go_binary(
    name = "gateway-simulator",
    embed = [":gateway-simulator_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "gateway-simulator_test",
    srcs = ["metrics_test.go", "publish_test.go", "scenario_test.go"],
    data = ["//testdata:fleets", "//testdata:scenarios"],
    embed = [":gateway-simulator_lib"],
    deps = [
        "//contracts/gen/go/gridos/v1:gridos",
        "//services/gateway-simulator/internal/failures",
        "//services/gateway-simulator/internal/gateway",
        "//services/gateway-simulator/internal/protocol",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
