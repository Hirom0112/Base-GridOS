#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

go_bin=$(go env GOBIN 2>/dev/null || true)
[ -n "$go_bin" ] || go_bin="$(go env GOPATH 2>/dev/null || true)/bin"
[ -d "$go_bin" ] && PATH="$go_bin:$PATH"
export PATH

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

fail() {
  printf '\nGATE RED: %s\n' "$1" >&2
  exit 1
}

python_project() {
  project=$(dirname "$1")
  while [ "$project" != "." ] && [ ! -f "$project/pyproject.toml" ]; do project=$(dirname "$project"); done
  [ -f "$project/pyproject.toml" ] && printf '%s\n' "$project"
  return 0
}

python_tests_importing() {
  project=$(python_project "$1")
  [ -n "$project" ] || return 0
  rel=${1#"$project"/}; rel=${rel%.py}; rel=${rel%/__init__}
  pattern="^(from|import)[[:space:]]+([A-Za-z0-9_.]*\.)?$(printf '%s' "$rel" | tr / . | sed 's/\./\\./g')([[:space:]]|,|$)"
  case "$rel" in */*) pattern="$pattern|^from[[:space:]]+([A-Za-z0-9_.]*\.)?$(printf '%s' "${rel%/*}" | tr / . | sed 's/\./\\./g')[[:space:]]+import[[:space:]].*\b${rel##*/}\b" ;; esac
  git ls-files -- "$project" | grep -E '(^|/)test_[^/]+\.py$' | xargs grep -lE "$pattern" 2>/dev/null || true
}

command -v gitleaks >/dev/null || fail "gitleaks is not installed"
gitleaks protect --staged --redact --no-banner || fail "gitleaks staged secrets"

code_files=$(printf '%s\n' "$staged" | grep -E '\.(go|py|ts|tsx|js|mjs|sql|proto)$' | grep -vE '(^|/)gen/|_pb2\.py$|\.pb\.go$|connect\.go$' || true)

tests_only=1
for f in $code_files; do
  case "$f" in
    *_test.go|*/test_*.py|test_*.py|*.test.ts|*.test.tsx|*.spec.ts) ;;
    *) tests_only=0 ;;
  esac
done
[ "$tests_only" -eq 1 ] && printf 'tests-only commit: RED allowed, execution skipped\n'

if [ -n "$code_files" ]; then
  added=$(git diff --cached -U0 -- $code_files | grep -E '^\+[^+]' | sed 's/^+//' || true)

  cstyle_files=$(printf '%s\n' $code_files | grep -E '\.(go|ts|tsx|js|mjs|proto)$' || true)
  cstyle=""
  [ -z "$cstyle_files" ] || cstyle=$(git diff --cached -U0 -- $cstyle_files | grep -E '^\+[^+]' | sed 's/^+//' || true)
  starred=$(printf '%s\n' "$cstyle" | grep -E '^[[:space:]]*\*[[:space:]]' || true)
  comments=$(printf '%s\n' "$added" \
    | grep -E '^[[:space:]]*(//|#|/\*|--[[:space:]]|--$|\{/\*)' \
    | grep -vE '^[[:space:]]*(//go:|#!|// Code generated|#[[:space:]]*-\*-|/// <reference)' \
    | grep -vE '^[[:space:]]*-- name: [A-Za-z][A-Za-z0-9_]* :(one|many|exec|execresult|execrows|execlastid|batchexec|batchmany|batchone|copyfrom)[[:space:]]*$' || true)
  comments=$(printf '%s\n' "$comments" "$starred" | grep -v '^$' || true)
  [ -z "$comments" ] || fail "added comment lines (rename or restructure instead):
$comments"

  suppressions=$(printf '%s\n' "$added" \
    | grep -nE 'nolint|noqa|eslint-disable|@ts-ignore|@ts-expect-error|type:[[:space:]]*ignore|pragma:[[:space:]]*no cover|#nosec' || true)
  [ -z "$suppressions" ] || fail "suppression markers are forbidden:
$suppressions"

  anys=$(printf '%s\n' "$added" | grep -nE '(:[[:space:]]*any\b|as any\b|typing\.Any|:[[:space:]]*Any\b|\binterface\{\}\s*$)' || true)
  [ -z "$anys" ] || fail "no any / Any / bare interface{}:
$anys"

  go_code=$(printf '%s\n' $code_files | grep -E '\.go$' || true)
  go_anys=""
  [ -z "$go_code" ] || go_anys=$(git diff --cached -U0 -- $go_code | grep -E '^\+[^+]' | sed 's/^+//' \
    | sed -E 's/"([^"\\]|\\.)*"//g; s/`[^`]*`//g; s#//.*##; s/((func|type)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*)\[[^]]*\]/\1/' \
    | grep -nE '(^|[^A-Za-z0-9_.])any([^A-Za-z0-9_]|$)' || true)
  [ -z "$go_anys" ] || fail "no any as a Go type outside type-parameter constraints:
$go_anys"

  for f in $code_files; do
    lines=$(git show ":$f" | wc -l | tr -d ' ')
    [ "$lines" -le 500 ] || fail "$f has $lines lines (ceiling 500). Extract along a real seam."
  done
fi

go_files=$(printf '%s\n' "$staged" | grep -E '\.go$' | grep -vE '\.pb\.go$|connect\.go$' || true)
if [ -n "$go_files" ]; then
  command -v go >/dev/null || fail "go is not installed"
  unformatted=$(gofmt -l $go_files || true)
  [ -z "$unformatted" ] || fail "gofmt: $unformatted"
  command -v golangci-lint >/dev/null || fail "golangci-lint is not installed"
  pairs=$(mktemp)
  for f in $go_files; do
    dir=$(dirname "$f")
    mod=$(cd "$dir" && go list -f '{{.Module.Dir}}' . 2>/dev/null) || fail "$dir is not inside a Go module"
    printf '%s %s\n' "$mod" "$root/$dir" >> "$pairs"
  done
  for mod in $(cut -d' ' -f1 "$pairs" | sort -u); do
    pkgs=$(grep "^$mod " "$pairs" | cut -d' ' -f2 | sort -u | sed "s#^$mod#.#" | tr '\n' ' ')
    (cd "$mod" && go vet $pkgs) || fail "go vet"
    (cd "$mod" && golangci-lint run --config "$root/.golangci.yml" $pkgs) || fail "golangci-lint"
    [ "$tests_only" -eq 1 ] || (cd "$mod" && go test -count=1 -short -timeout 90s $pkgs) || fail "go test (staged packages)"
  done
  rm -f "$pairs"
fi

py_files=$(printf '%s\n' "$staged" | grep -E '\.py$' | grep -vE '_pb2(_grpc)?\.py$' || true)
if [ -n "$py_files" ]; then
  command -v ruff >/dev/null || command -v uv >/dev/null || fail "ruff (or uv) is not installed"
  RUFF="ruff"; command -v ruff >/dev/null || RUFF="uvx --quiet ruff"
  $RUFF format --check $py_files || fail "ruff format"
  $RUFF check $py_files || fail "ruff check"
  uv run --quiet --no-project --python 3.12 python - $py_files <<'PY' || fail "python docstrings, comments, 150-line functions or nesting over 4"
import ast
import io
import subprocess
import sys
import tokenize

BLOCKS = (ast.If, ast.For, ast.AsyncFor, ast.While, ast.With, ast.AsyncWith, ast.Try, ast.TryStar, ast.Match)
SCOPES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)


def depth(node: ast.AST, level: int = 0) -> int:
    return max(
        [level]
        + [depth(child, level + isinstance(child, BLOCKS)) for child in ast.iter_child_nodes(node) if not isinstance(child, SCOPES)]
    )


def violations(path: str, source: str) -> list[str]:
    found = []
    for node in ast.walk(ast.parse(source)):
        line = getattr(node, "lineno", 1)
        if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) and ast.get_docstring(node) is not None:
            found.append(f"{path}:{line}: docstring")
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            length = (node.end_lineno or line) - line + 1
            if length > 150:
                found.append(f"{path}:{line}: function has {length} lines (ceiling 150)")
            if depth(node) > 4:
                found.append(f"{path}:{line}: nesting depth {depth(node)} (ceiling 4)")
    for token in tokenize.generate_tokens(io.StringIO(source).readline):
        directive = token.start[0] <= 2 and token.string.startswith(("#!", "# -*-"))
        if token.type == tokenize.COMMENT and not directive:
            found.append(f"{path}:{token.start[0]}: comment {token.string}")
    return found


problems = [
    problem
    for path in sys.argv[1:]
    for problem in violations(path, subprocess.run(["git", "show", f":{path}"], capture_output=True, text=True, check=True).stdout)
]
if problems:
    sys.exit("\n".join(problems))
PY
  tests=$(printf '%s\n' $py_files | grep -E '(^|/)test_[^/]+\.py$' || true)
  for f in $(printf '%s\n' $py_files | grep -vE '(^|/)test_[^/]+\.py$' || true); do
    tests="$tests $(python_tests_importing "$f")"
  done
  if [ "$tests_only" -eq 0 ] && [ -n "$(printf '%s' "$tests" | tr -d ' \n')" ]; then
    runs=$(mktemp)
    for t in $(printf '%s\n' $tests | sort -u); do
      project=$(python_project "$t")
      [ -n "$project" ] || fail "no pyproject.toml above $t"
      printf '%s %s\n' "$project" "$t" >> "$runs"
    done
    for project in $(cut -d' ' -f1 "$runs" | sort -u); do
      uv run --quiet --project "$project" pytest -q -x $(grep "^$project " "$runs" | cut -d' ' -f2) || fail "pytest $project"
    done
    rm -f "$runs"
  fi
fi

ts_files=$(printf '%s\n' "$staged" | grep -E '^apps/console/.*\.(ts|tsx|js|mjs)$' | grep -vE '/gen/' || true)
if [ -n "$ts_files" ] && [ -f apps/console/package.json ]; then
  command -v pnpm >/dev/null || fail "pnpm is not installed"
  rel=$(printf '%s\n' $ts_files | sed 's#^apps/console/##')
  (cd apps/console && pnpm exec prettier --check $rel) || fail "prettier"
  (cd apps/console && pnpm exec eslint --max-warnings 0 $rel) || fail "eslint"
  [ "$tests_only" -eq 1 ] || (cd apps/console && pnpm exec vitest related --run $rel) || fail "vitest related"
fi

proto_files=$(printf '%s\n' "$staged" | grep -E '\.proto$' || true)
if [ -n "$proto_files" ]; then
  command -v buf >/dev/null || fail "buf is not installed"
  buf lint contracts || fail "buf lint"
fi

exit 0
