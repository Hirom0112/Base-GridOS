load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "worker_lib",
    srcs = ["main.go"],
    importpath = "github.com/Hirom0112/Base-GridOS/services/control/cmd/worker",
    visibility = ["//visibility:private"],
    deps = [
        "//contracts/gen/go/gridos/v1:gridos",
        "//contracts/gen/go/gridos/v1/gridosv1connect",
        "//services/control/internal/api",
        "//services/control/internal/dispatch",
        "//services/control/internal/fleet",
        "//services/control/internal/fleet/policy",
        "//services/control/internal/observability",
        "//services/control/internal/reconciliation",
        "//services/control/internal/replay",
        "//services/control/internal/storage",
        "//services/control/internal/storage/publisher",
        "@com_connectrpc_connect//:connect",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel_exporters_stdout_stdouttrace//:stdouttrace",
        "@io_temporal_go_api//enums/v1:enums",
        "@io_temporal_go_api//serviceerror",
        "@io_temporal_go_sdk//client",
        "@io_temporal_go_sdk//worker",
    ],
)

go_binary(
    name = "worker",
    embed = [":worker_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "worker_test",
    srcs = ["main_test.go"],
    embed = [":worker_lib"],
    deps = [
        "//contracts/gen/go/gridos/v1:gridos",
        "@com_github_stretchr_testify//require",
    ],
)
