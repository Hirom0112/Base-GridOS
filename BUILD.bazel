load("@gazelle//:def.bzl", "gazelle")

exports_files(["go.work", "MODULE.bazel"])

filegroup(
    name = "proto_files",
    srcs = glob(["contracts/**/*.proto"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "proto_inputs",
    srcs = [":proto_files", "contracts/buf.yaml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "container_inputs",
    srcs = [
        ":proto_inputs",
        "//database:migrations",
        "//database:rollback",
        "//database:seeds",
    ] + glob(["infrastructure/aws/go.gen.yaml"]),
    visibility = ["//visibility:public"],
)

gazelle(name = "gazelle")
