{
  "uid": "gridos-fleet",
  "title": "GridOS Fleet",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Telemetry freshness", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "gridos-prometheus"}, "targets": [{"expr": "gridos_telemetry_freshness_seconds", "refId": "A"}], "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "title": "Stale telemetry share", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "gridos-prometheus"}, "targets": [{"expr": "gridos_telemetry_stale_devices / clamp_min(gridos_telemetry_devices, 1)", "refId": "A"}], "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}}
  ]
}
