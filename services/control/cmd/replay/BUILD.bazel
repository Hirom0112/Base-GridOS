load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "replay_lib",
    srcs = ["main.go"],
    importpath = "github.com/Hirom0112/Base-GridOS/services/control/cmd/replay",
    visibility = ["//visibility:private"],
    deps = [
        "//contracts/gen/go/gridos/v1/gridosv1connect",
        "//services/control/internal/api",
        "//services/control/internal/replay",
        "@com_connectrpc_connect//:connect",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_binary(
    name = "replay",
    embed = [":replay_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "replay_test",
    srcs = ["main_test.go"],
    embed = [":replay_lib"],
    deps = [
        "//contracts/gen/go/gridos/v1:gridos",
        "//services/control/internal/replay",
        "@com_github_stretchr_testify//require",
    ],
)
