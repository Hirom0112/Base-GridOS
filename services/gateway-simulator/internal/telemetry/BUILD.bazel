load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "telemetry",
    srcs = [
        "fleet.go",
        "producer.go",
        "profiles.go",
        "publisher.go",
    ],
    importpath = "github.com/Hirom0112/Base-GridOS/services/gateway-simulator/internal/telemetry",
    visibility = ["//services/gateway-simulator:__subpackages__"],
    deps = [
        "//contracts/gen/go/gridos/v1:gridos",
        "//contracts/gen/go/gridos/v1/gridosv1connect",
