module(name = "base_gridos")

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_buf", version = "0.5.4")
bazel_dep(name = "rules_shell", version = "0.6.1")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(
    sha256 = "18f603d3b418f6a1259da4425b04bbe2fbaf60c2b796b98114d961e8736198b9",
    version = "v1.73.0",
)
use_repo(buf, "rules_buf_toolchains")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_work = "//:go.work")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")
use_repo(go_deps, "com_connectrpc_connect", "com_github_golang_migrate_migrate_v4", "com_github_jackc_pgx_v5", "com_github_prometheus_client_golang", "com_github_stretchr_testify", "com_github_uber_h3_go_v4", "in_gopkg_yaml_v3", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_stdout_stdouttrace", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_trace", "io_temporal_go_api", "io_temporal_go_sdk", "net_pgregory_rapid", "org_golang_google_protobuf", "org_golang_x_oauth2", "org_modernc_sqlite")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12.13")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "gridos_pypi",
    python_version = "3.12.13",
    uv_lock = "//services/decision:uv.lock",
)
use_repo(pip, "gridos_pypi")
