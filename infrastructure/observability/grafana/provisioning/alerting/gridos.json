{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "GridOS operational alerts",
      "folder": "GridOS",
      "interval": "1m",
      "rules": [
        {
          "uid": "gridos-safety-rejections",
          "title": "Safety rejections",
          "condition": "B",
          "for": "0s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "dashboardUid": "gridos-dispatch",
          "panelId": 3,
          "data": [
            {
              "refId": "A",
              "datasourceUid": "gridos-prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "expr": "sum(increase(gridos_safety_rejections_total[5m]))",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "refId": "B",
                "type": "classic_conditions"
              }
            }
          ]
        },
        {
          "uid": "gridos-fallback-rate",
          "title": "Fallback rate",
          "condition": "B",
          "for": "5m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "dashboardUid": "gridos-failure-recovery",
          "panelId": 1,
          "data": [
            {
              "refId": "A",
              "datasourceUid": "gridos-prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "expr": "sum(rate(gridos_fallback_total[5m]))",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "refId": "B",
                "type": "classic_conditions"
              }
            }
          ]
        },
        {
          "uid": "gridos-uncertain-commands",
          "title": "Uncertain commands",
          "condition": "B",
          "for": "0s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "dashboardUid": "gridos-failure-recovery",
          "panelId": 2,
          "data": [
            {
              "refId": "A",
              "datasourceUid": "gridos-prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "expr": "gridos_uncertain_commands",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "refId": "B",
                "type": "classic_conditions"
              }
            }
          ]
        },
        {
          "uid": "gridos-stale-telemetry",
          "title": "Stale telemetry share",
          "condition": "B",
          "for": "5m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "dashboardUid": "gridos-fleet",
          "panelId": 2,
          "data": [
            {
              "refId": "A",
              "datasourceUid": "gridos-prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "expr": "gridos_telemetry_stale_devices / clamp_min(gridos_telemetry_devices, 1)",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.05
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "refId": "B",
                "type": "classic_conditions"
              }
            }
          ]
        }
      ]
    }
  ]
}
