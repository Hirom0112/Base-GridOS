use_repo(go_deps, "com_connectrpc_connect", "com_github_golang_migrate_migrate_v4", "com_github_jackc_pgx_v5", "com_github_prometheus_client_golang", "com_github_stretchr_testify", "com_github_uber_h3_go_v4", "in_gopkg_yaml_v3", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_stdout_stdouttrace", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_trace", "io_temporal_go_api", "io_temporal_go_sdk", "net_pgregory_rapid", "org_golang_google_protobuf", "org_modernc_sqlite")
